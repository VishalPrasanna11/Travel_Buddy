# TravelBuddy client settings. Copy to client/.env and fill in.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://travelbuddy-api
# Local API server. Leave empty in production builds: the app calls its own origin.
VITE_BASE_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=
