# TravelBuddy server settings. Copy to .env and fill in. Never commit .env.

# Database (local: docker compose up postgres → localhost:5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=travelbuddy
DB_USER=travelbuddy
DB_PASSWORD=
DB_SSL_MODE=disable
# Production uses DATABASE_URL instead (set by Heroku Postgres)
# DATABASE_URL=

# Auth0 API (tokens are verified against this tenant; leave AUTH0_DOMAIN empty only for local dev)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://travelbuddy-api
FRONTEND_URL=http://localhost:3000

# Server
PORT=8000

# OpenAI (agent and narrative)
OPENAI_API_KEY=

# Google (Places API (New), geocoding, photos)
GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=

# Weather (One Call 3.0 if subscribed, otherwise the free 5-day forecast is used)
OPENWEATHER_API_KEY=

# RouteStack (flights, hotels, cars, checkout)
ROUTESTACK_API_KEY=
ROUTESTACK_API_SECRET=
ROUTESTACK_BASE_URL=
ROUTESTACK_ACCOUNT_ID=

# Local development switches
# TRAVELBUDDY_FIXTURES=1      # canned results, no provider calls
# ALLOW_ANONYMOUS_ASK=1       # allow /api/llm/ask without sign-in

# Client build args used by docker compose (same values as client/.env)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://travelbuddy-api
VITE_BASE_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=
